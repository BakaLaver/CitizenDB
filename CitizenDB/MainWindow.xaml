<Window x:Class="CitizenDB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CitizenDB"
        mc:Ignorable="d"
        Title="CitizenDB" Height="450" Width="800"
        AllowDrop="True"
        Drop="CityFileCather_Drop">

    <Window.Background>
        <ImageBrush ImageSource="/Site-background-dark.webp" Stretch="Fill"/>
    </Window.Background>

    <Grid>
        <!-- Основной контент -->
        <Border Background="#80000000"
                CornerRadius="15"
                Padding="30,15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,80,0,0">
            <TextBlock Text="Перетащите файл города (.cit / .citb) сюда"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center"/>
        </Border>

        <!-- Индикатор загрузки -->
        <Border x:Name="LoadingOverlay" 
                Background="#CC000000" 
                Visibility="Collapsed"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center">

                <!-- Кружок загрузки -->
                <Grid Width="60" Height="60">
                    <Ellipse Width="60" Height="60" 
                             Stroke="#444444" 
                             StrokeThickness="5"/>
                    <Ellipse Width="60" Height="60" 
                             Stroke="#FFFFFF" 
                             StrokeThickness="5"
                             StrokeDashArray="1.5, 1.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" 
                                             CenterX="30" CenterY="30"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- Текст загрузки -->
                <TextBlock x:Name="LoadingText"
                           Text="Загрузка файла..." 
                           FontSize="18" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>